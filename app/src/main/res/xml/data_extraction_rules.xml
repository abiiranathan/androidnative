<?xml version="1.0" encoding="utf-8"?>
<!-- The app is a toolchain test app; do not back up or transfer its data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
